{
  "name": "chat-on-steroids",
  "version": "2.0.2",
  "description": "Local coding bridge for ChatGPT over MCP, with Windows-only desktop control and approved-folder capability limits.",
  "license": "MIT",
  "author": "Chat On Steroids",
  "homepage": "https://github.com/totec448-spec/chat-on-steroids",
  "desktopName": "com.chatonsteroids.app.desktop",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "headless": "tsx src/main/headless.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run verify:ci",
    "verify:ci": "npm run rg && npm run verify:privacy && npm run typecheck",
    "verify:live": "node scripts/live-chatgpt-workstream.mjs --live",
    "verify:privacy": "node scripts/verify-public-history.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "icon": "node scripts/make-icon.mjs",
    "tunnel": "node scripts/fetch-tunnel-client.mjs",
    "rg": "node scripts/fetch-ripgrep.mjs",
    "packaging:prepare": "node scripts/prepare-packaging-native.mjs",
    "dist": "node scripts/package.mjs --arch x64,arm64",
    "dist:win": "node scripts/package.mjs --platform win32 --arch x64,arm64",
    "dist:x64": "node scripts/package.mjs --platform win32 --arch x64",
    "dist:arm64": "node scripts/package.mjs --platform win32 --arch arm64",
    "dist:mac": "node scripts/package.mjs --platform darwin --arch x64,arm64",
    "dist:mac:x64": "node scripts/package.mjs --platform darwin --arch x64",
    "dist:mac:arm64": "node scripts/package.mjs --platform darwin --arch arm64",
    "dist:linux": "node scripts/package.mjs --platform linux --arch x64,arm64",
    "dist:linux:x64": "node scripts/package.mjs --platform linux --arch x64",
    "dist:linux:arm64": "node scripts/package.mjs --platform linux --arch arm64",
    "dist:dir": "node scripts/package.mjs --arch x64,arm64 --dir",
    "dist:dir:win": "node scripts/package.mjs --platform win32 --arch x64,arm64 --dir",
    "dist:dir:x64": "node scripts/package.mjs --platform win32 --arch x64 --dir",
    "dist:dir:arm64": "node scripts/package.mjs --platform win32 --arch arm64 --dir",
    "dist:dir:mac:x64": "node scripts/package.mjs --platform darwin --arch x64 --dir",
    "dist:dir:mac:arm64": "node scripts/package.mjs --platform darwin --arch arm64 --dir",
    "dist:dir:mac": "node scripts/package.mjs --platform darwin --arch x64,arm64 --dir",
    "dist:dir:linux:x64": "node scripts/package.mjs --platform linux --arch x64 --dir",
    "dist:dir:linux:arm64": "node scripts/package.mjs --platform linux --arch arm64 --dir",
    "dist:dir:linux": "node scripts/package.mjs --platform linux --arch x64,arm64 --dir"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "node-pty": "1.2.0-beta.15",
    "quickjs-emscripten-core": "0.32.0",
    "sharp": "0.35.3",
    "tree-sitter": "0.25.1",
    "tree-sitter-bash": "0.25.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "43.4.1",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "tsx": "^4.19.3",
    "vite": "^7.3.6"
  }
}
